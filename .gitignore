# Изолированные рабочие копии Git не должны попадать в основной репозиторий.
.worktrees/
worktrees/

# Локальный бинарный файл проекта собирается заново и не хранится в Git.
/fstab-edit

# Каталог распространяемых сборок формируется автоматически.
/dist/

# Результаты тестов и профилирования являются локальными артефактами.
*.test
*.out
/coverage.*

# Временные файлы операционной системы и редакторов не относятся к исходному коду.
*~
*.swp
*.swo
